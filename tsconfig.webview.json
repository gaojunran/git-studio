{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/webview/**/*.ts", "src/webview/**/*.tsx", "src/board/**/*.ts", "src/board/**/*.tsx", "src/sidebar/**/*.ts", "src/sidebar/**/*.tsx", "src/shared/**/*.ts"]
}
