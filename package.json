{
  "name": "git-studio",
  "displayName": "Git Studio",
  "description": "IntelliJ-style Git history for VS Code: multi-ref commit graph, deep history search, file history and full-file blame.",
  "version": "0.2.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "history",
    "graph",
    "blame",
    "log"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "gitStudio.openHistory",
        "title": "Open History",
        "category": "Git Studio",
        "icon": "$(history)"
      },
      {
        "command": "gitStudio.fileHistory",
        "title": "File History",
        "category": "Git Studio",
        "icon": "$(history)"
      },
      {
        "command": "gitStudio.annotateFile",
        "title": "Annotate File (Blame)",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.toggleAnnotate",
        "title": "Toggle File Annotate",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.openCommit",
        "title": "Open Commit in History",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.goToCommit",
        "title": "Go to Commit…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.refresh",
        "title": "Refresh",
        "category": "Git Studio",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitStudio.openHistory",
          "when": "scmProvider == git",
          "group": "navigation@10"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "gitStudio.fileHistory",
          "when": "scmProvider == git",
          "group": "1_history@1"
        },
        {
          "command": "gitStudio.annotateFile",
          "when": "scmProvider == git",
          "group": "1_history@2"
        }
      ],
      "explorer/context": [
        {
          "command": "gitStudio.fileHistory",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "9_git@1"
        }
      ],
      "editor/context": [
        {
          "command": "gitStudio.fileHistory",
          "when": "resourceScheme == file",
          "group": "9_git@1"
        },
        {
          "command": "gitStudio.annotateFile",
          "when": "resourceScheme == file",
          "group": "9_git@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitStudio.openHistory",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ],
    "configuration": {
      "title": "Git Studio",
      "properties": {
        "gitStudio.history.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Commits loaded per page."
        },
        "gitStudio.history.defaultRefs": {
          "type": "string",
          "enum": [
            "primary",
            "current",
            "all"
          ],
          "default": "primary",
          "markdownDescription": "Refs shown when the history panel opens. `primary` = current branch, its upstream, main/master/develop, recently updated local branches and pinned refs. `current` = current branch only. `all` = every ref (can produce a very wide graph)."
        },
        "gitStudio.history.recentRefLimit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 30,
          "description": "How many recently updated local branches to add in primary mode (0 = only primary branches, upstream and pinned refs)."
        },
        "gitStudio.history.pinnedRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Ref names or glob patterns that are always included, e.g. `release/*` or `origin/main`."
        },
        "gitStudio.history.order": {
          "type": "string",
          "enum": [
            "date",
            "topo"
          ],
          "default": "date",
          "description": "Default commit ordering."
        },
        "gitStudio.annotate.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show full-file blame annotations for the active editor."
        },
        "gitStudio.annotate.template": {
          "type": "string",
          "default": "${authorName} · ${authorDateAgo} · ${summary}",
          "description": "Annotation template. Supports ${authorName}, ${authorEmail}, ${authorDate}, ${authorDateAgo}, ${summary}, ${shortHash}."
        },
        "gitStudio.annotate.ignoreWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Ignore whitespace changes when computing blame."
        },
        "gitStudio.git.path": {
          "type": "string",
          "default": "",
          "description": "Path to the git executable. Empty uses the path resolved by the built-in Git extension."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:web",
    "build:ext": "node esbuild.mjs",
    "build:web": "vite build",
    "watch": "concurrently -n ext,web -c blue,green \"node esbuild.mjs --watch\" \"vite build --watch\"",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "install:local": "npm run build && npx --yes @vscode/vsce package --no-dependencies --out dist/git-studio-$npm_package_version.vsix && code --install-extension dist/git-studio-$npm_package_version.vsix --force",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.0"
  }
}
