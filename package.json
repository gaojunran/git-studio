{
  "name": "git-studio",
  "displayName": "Git Studio",
  "description": "IntelliJ-style Git history for VS Code: multi-ref commit graph, deep history search, file history and full-file blame.",
  "version": "0.22.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "history",
    "graph",
    "blame",
    "log"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:gitStudio.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitStudio",
          "title": "Git Studio",
          "icon": "resources/git-studio.svg"
        }
      ]
    },
    "views": {
      "gitStudio": [
        {
          "id": "gitStudio.sidebar",
          "name": "Workspace",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gitStudio.openHistory",
        "title": "Open History",
        "category": "Git Studio",
        "icon": "$(history)"
      },
      {
        "command": "gitStudio.openSidebar",
        "title": "Focus Git Studio Sidebar",
        "category": "Git Studio",
        "icon": "$(source-control)"
      },
      {
        "command": "gitStudio.openBoard",
        "title": "Open Issues & Pull Requests",
        "category": "Git Studio",
        "icon": "$(issues)"
      },
      {
        "command": "gitStudio.boardConnectGithub",
        "title": "Connect GitHub for Board",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.boardInstallIntegration",
        "title": "Install Integration Extension…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.boardInstallIntegrationFromGit",
        "title": "Install Integration Extension from Git…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.boardInstallIntegrationFromArchive",
        "title": "Install Integration Extension from Archive…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.boardUpdateIntegration",
        "title": "Update Integration Extension…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.boardConnectIntegration",
        "title": "Connect Integration Account…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.boardRemoveIntegration",
        "title": "Remove Integration Extension…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.fileHistory",
        "title": "File History",
        "category": "Git Studio",
        "icon": "$(history)"
      },
      {
        "command": "gitStudio.selectionHistory",
        "title": "History for Selection",
        "category": "Git Studio",
        "icon": "$(list-selection)"
      },
      {
        "command": "gitStudio.annotateFile",
        "title": "Annotate File (Blame)",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.toggleAnnotate",
        "title": "Toggle File Annotate",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.openCommit",
        "title": "Open Commit in History",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.goToCommit",
        "title": "Go to Commit…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.folderHistory",
        "title": "Folder History",
        "category": "Git Studio",
        "icon": "$(folder)"
      },
      {
        "command": "gitStudio.multiPathHistory",
        "title": "History for Selected Paths",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.worktreeWorkbench",
        "title": "Worktrees…",
        "category": "Git Studio",
        "icon": "$(folder)"
      },
      {
        "command": "gitStudio.reflogWorkbench",
        "title": "Reflog…",
        "category": "Git Studio",
        "icon": "$(history)"
      },
      {
        "command": "gitStudio.reflogUndo",
        "title": "Restore HEAD from Reflog…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.stashWorkbench",
        "title": "Stash Workbench…",
        "category": "Git Studio",
        "icon": "$(archive)"
      },
      {
        "command": "gitStudio.exportPatch",
        "title": "Export Patch…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.applyPatch",
        "title": "Apply Patch…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.exportGraph",
        "title": "Export History Graph (SVG)…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.diffReflog",
        "title": "Compare with Reflog Entry…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.diffIncoming",
        "title": "Compare Incoming Commits…",
        "category": "Git Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitStudio.diffTagPrevious",
        "title": "Compare Tag with Previous Tag…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.diffRemoteTracking",
        "title": "Compare Against Remote Tracking Branch…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.undoLastRewrite",
        "title": "Undo Last Rewrite",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.compareWorkingTree",
        "title": "Compare Working Tree with Merge Base…",
        "category": "Git Studio"
      },
      {
        "command": "gitStudio.diffRefs",
        "title": "Compare Two Refs…",
        "category": "Git Studio",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitStudio.diffRefsMergeBase",
        "title": "Compare Two Refs with Merge Base…",
        "category": "Git Studio",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitStudio.diffMergeBase",
        "title": "Compare Current Branch with Merge Base…",
        "category": "Git Studio",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitStudio.diffStash",
        "title": "Compare Stash…",
        "category": "Git Studio",
        "icon": "$(archive)"
      },
      {
        "command": "gitStudio.diffFileRevisions",
        "title": "Compare File at Two Revisions…",
        "category": "Git Studio",
        "icon": "$(diff)"
      },
      {
        "command": "gitStudio.diffFolder",
        "title": "Compare Folder with Working Tree…",
        "category": "Git Studio",
        "icon": "$(folder)"
      },
      {
        "command": "gitStudio.diffUnpushed",
        "title": "Compare Unpushed Commits…",
        "category": "Git Studio",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitStudio.refresh",
        "title": "Refresh",
        "category": "Git Studio",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitStudio.openHistory",
          "when": "scmProvider == git",
          "group": "navigation@10"
        },
        {
          "command": "gitStudio.worktreeWorkbench",
          "when": "scmProvider == git",
          "group": "navigation@6"
        },
        {
          "command": "gitStudio.reflogWorkbench",
          "when": "scmProvider == git",
          "group": "navigation@7"
        },
        {
          "command": "gitStudio.stashWorkbench",
          "when": "scmProvider == git",
          "group": "navigation@8"
        },
        {
          "command": "gitStudio.openBoard",
          "when": "scmProvider == git",
          "group": "navigation@9"
        },
        {
          "command": "gitStudio.compareWorkingTree",
          "when": "scmProvider == git",
          "group": "navigation@11"
        },
        {
          "command": "gitStudio.diffUnpushed",
          "when": "scmProvider == git",
          "group": "1_compare@1"
        },
        {
          "command": "gitStudio.diffStash",
          "when": "scmProvider == git",
          "group": "1_compare@2"
        },
        {
          "command": "gitStudio.diffRefs",
          "when": "scmProvider == git",
          "group": "1_compare@3"
        },
        {
          "command": "gitStudio.diffRefsMergeBase",
          "when": "scmProvider == git",
          "group": "1_compare@4"
        },
        {
          "command": "gitStudio.diffMergeBase",
          "when": "scmProvider == git",
          "group": "1_compare@5"
        },
        {
          "command": "gitStudio.diffIncoming",
          "when": "scmProvider == git",
          "group": "1_compare@6"
        },
        {
          "command": "gitStudio.diffTagPrevious",
          "when": "scmProvider == git",
          "group": "1_compare@7"
        },
        {
          "command": "gitStudio.diffRemoteTracking",
          "when": "scmProvider == git",
          "group": "1_compare@8"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "gitStudio.fileHistory",
          "when": "scmProvider == git",
          "group": "1_history@1"
        },
        {
          "command": "gitStudio.annotateFile",
          "when": "scmProvider == git",
          "group": "1_history@2"
        }
      ],
      "explorer/context": [
        {
          "command": "gitStudio.fileHistory",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "9_git@1"
        },
        {
          "command": "gitStudio.compareWorkingTree",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "9_git@2"
        },
        {
          "command": "gitStudio.diffFileRevisions",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "9_git@3"
        },
        {
          "command": "gitStudio.folderHistory",
          "when": "explorerResourceIsFolder && resourceScheme == file",
          "group": "9_git@1"
        },
        {
          "command": "gitStudio.multiPathHistory",
          "when": "resourceScheme == file",
          "group": "9_git@4"
        },
        {
          "command": "gitStudio.diffFolder",
          "when": "explorerResourceIsFolder && resourceScheme == file",
          "group": "9_git@1"
        }
      ],
      "editor/context": [
        {
          "command": "gitStudio.fileHistory",
          "when": "resourceScheme == file",
          "group": "9_git@1"
        },
        {
          "command": "gitStudio.selectionHistory",
          "when": "resourceScheme == file",
          "group": "9_git@1"
        },
        {
          "command": "gitStudio.annotateFile",
          "when": "resourceScheme == file",
          "group": "9_git@2"
        },
        {
          "command": "gitStudio.compareWorkingTree",
          "when": "resourceScheme == file",
          "group": "9_git@3"
        },
        {
          "command": "gitStudio.diffFileRevisions",
          "when": "resourceScheme == file",
          "group": "9_git@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitStudio.openHistory",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      },
      {
        "command": "gitStudio.compareWorkingTree",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      }
    ],
    "configuration": {
      "title": "Git Studio",
      "properties": {
        "gitStudio.history.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Commits loaded per page."
        },
        "gitStudio.history.defaultRefs": {
          "type": "string",
          "enum": [
            "primary",
            "current",
            "all"
          ],
          "default": "primary",
          "markdownDescription": "Refs shown when the history panel opens. `primary` = current branch, its upstream, local `main`/`master`/`develop`/`dev`/`trunk`/`release`, recently updated local branches and pinned refs. `current` = current branch only. `all` = every ref (can produce a very wide graph). This is separate from the ref picker's base-branch inference, which uses remote HEAD and fork-point analysis."
        },
        "gitStudio.history.recentRefLimit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 30,
          "description": "How many recently updated local branches to add in primary mode (0 = only primary branches, upstream and pinned refs)."
        },
        "gitStudio.history.pinnedRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Ref names or glob patterns that are always included, e.g. `release/*` or `origin/main`."
        },
        "gitStudio.history.favoriteRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Refs starred in the Branches sidebar."
        },
        "gitStudio.history.columns": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "graph",
              "subject",
              "refs",
              "author",
              "date",
              "hash"
            ]
          },
          "default": [
            "graph",
            "subject",
            "refs",
            "author",
            "date"
          ],
          "description": "Columns shown in the commit list."
        },
        "gitStudio.history.timeField": {
          "type": "string",
          "enum": [
            "author",
            "commit"
          ],
          "default": "author",
          "description": "Which timestamp the Date column shows."
        },
        "gitStudio.history.order": {
          "type": "string",
          "enum": [
            "date",
            "topo"
          ],
          "default": "date",
          "description": "Default commit ordering."
        },
        "gitStudio.annotate.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show full-file blame annotations for the active editor."
        },
        "gitStudio.annotate.template": {
          "type": "string",
          "default": "${authorName} · ${authorDateAgo} · ${summary}",
          "description": "Annotation template. Supports ${authorName}, ${authorEmail}, ${authorDate}, ${authorDateAgo}, ${summary}, ${shortHash}."
        },
        "gitStudio.annotate.ignoreWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Ignore whitespace changes when computing blame."
        },
        "gitStudio.annotate.detectCopies": {
          "type": "boolean",
          "default": false,
          "description": "Detect lines copied from other files (-C -C). Slower on large files."
        },
        "gitStudio.annotate.ignoreRevsFile": {
          "type": "string",
          "default": "",
          "description": "Path to a .git-blame-ignore-revs file, relative to the repository root."
        },
        "gitStudio.remote.commitUrlTemplate": {
          "type": "string",
          "default": "",
          "description": "Custom commit URL template for self-hosted Git hosts. Use {url} for the remote URL and {hash} for the commit hash."
        },
        "gitStudio.git.path": {
          "type": "string",
          "default": "",
          "description": "Path to the git executable. Empty uses the path resolved by the built-in Git extension."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:web && npm run build:board && npm run build:sidebar",
    "build:ext": "node esbuild.mjs",
    "build:web": "vite build",
    "build:board": "vite build --config vite.board.config.mts",
    "build:sidebar": "vite build --config vite.sidebar.config.mts",
    "watch": "concurrently -n ext,web,board,sidebar -c blue,green,yellow,magenta \"node esbuild.mjs --watch\" \"vite build --watch\" \"vite build --watch --config vite.board.config.mts\" \"vite build --watch --config vite.sidebar.config.mts\"",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "install:local": "npm run build && npx --yes @vscode/vsce package --no-dependencies --out dist/git-studio-$npm_package_version.vsix && code --install-extension dist/git-studio-$npm_package_version.vsix --force",
    "vscode:prepublish": "npm run build",
    "test:integration": "bash test/integration/run.sh"
  },
  "dependencies": {
    "@openchamber/sdk": "^2.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.0"
  }
}
